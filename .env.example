# ---------------------------------------------------------------------------
# Shared, server-side settings (used by BOTH the web app and the CLI).
# On the shared web server, ONLY these two are needed - never put per-user
# Jira credentials on the server; those come from each user's browser.
# ---------------------------------------------------------------------------

# Jira site origin only, e.g. https://firemon.atlassian.net - no /browse/... path
JIRA_BASE_URL=https://firemon.atlassian.net

# Shared Groq API key. NEVER exposed to the browser and never returned by the API.
GROQ_API_KEY=your-groq-api-key

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Per-user Jira credentials - CLI ONLY.
# The web app collects these in the browser per user; do NOT set them on a
# shared web server. Set them here only when running the command-line tool.
# ---------------------------------------------------------------------------
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token   # create at https://id.atlassian.com/manage-profile/security/api-tokens

# ---------------------------------------------------------------------------
# Local development only: allow the Vite dev server (http://localhost:5173)
# to call this API cross-origin. Leave unset in production (SPA is same-origin).
# ---------------------------------------------------------------------------
# JGB_DEV_CORS=1
